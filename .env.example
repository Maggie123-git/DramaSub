# DramaSub Environment Configuration
# Copy this file to .env and fill in your actual API keys.

# Required: OpenAI API key. Always used for Whisper transcription, and for
# analysis/translation when LLM_PROVIDER=openai or GEMINI_API_KEY is missing.
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key for analysis and translation (the default provider).
# Get one at https://aistudio.google.com/apikey. Use a key from a project with
# billing enabled: on the free tier Google may use submitted content to
# improve its products. BYOK users always stay on OpenAI with their own key.
GEMINI_API_KEY=your_gemini_api_key_here

# Which AI analyzes and translates: gemini (default) or openai.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# Gemini thinking level for these structured tasks: minimal, low, medium, high.
GEMINI_REASONING_EFFORT=low

# Database
DATABASE_URL=postgresql://dramasub:dramasub@db:5432/dramasub

# File storage
UPLOAD_DIR=uploads
EXPORT_DIR=exports

# JWT signing secret (required).
# MUST be a strong, randomly generated string of at least 32 characters.
# The app will refuse to start with empty, default, or weak secrets.
# Generate one with: openssl rand -base64 32
# Do not use the default value in production.
JWT_SECRET_KEY=change-me-in-production

# Email (Resend) - optional; leave blank to disable sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DramaSub <hello@dramasub.app>
RESEND_VERIFY_TEMPLATE_ALIAS=verification
RESEND_WELCOME_TEMPLATE_ALIAS=welcome

# Frontend origin used for CORS (required).
# MUST exactly match the origin that serves the DramaSub frontend.
# The default below assumes the backend is also serving the frontend files.
# If you run the frontend on a separate dev server, update this to that origin
# (e.g., http://localhost:5173 for Vite, http://localhost:3000 for a static server,
# or https://dramasub.app in production).
FRONTEND_BASE_URL=http://localhost:8000

# Serve interactive API docs at /docs, /redoc and /openapi.json.
# Leave false in production. docker-compose already enables it for local dev.
ENABLE_API_DOCS=false

# Redis connection limits.
# These keep total Redis connections under Render's 50-connection cap.
# Celery worker: CELERY_WORKER_CONCURRENCY × (broker + backend pools).
# Shared app pool: used by web service and worker progress publishes.
# Render's free Redis plan allows 50 simultaneous connections.
CELERY_WORKER_CONCURRENCY=5
CELERY_BROKER_POOL_LIMIT=3
CELERY_REDIS_MAX_CONNECTIONS=3
CELERY_RESULT_BACKEND_MAX_CONNECTIONS=3
REDIS_MAX_CONNECTIONS=15
